# Copiar como .env y ajustar los valores
# cp .env.example .env

# Base de datos
DB_HOST=localhost
DB_NAME=inscripciones_club
DB_USER=root
DB_PASS=

# URL base del sitio (requerida para protección CSRF/Origin)
APP_URL=https://tu-dominio.com

# Correo (PHPMailer)
EMAIL_HOST=smtp.ejemplo.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Opcional
SHOW_CUPOS=false

# API externa (responsables, participantes, inscripción)
# Login previo (obligatorio): POST API_LOGIN → accessToken
# Body: { "usuario": API_USER, "clave": API_PASSWORD, "empresa": "03"|"04" }
# Empresa según línea del curso: línea 1 → 03, línea 2 → 04
# API_LOGIN=https://api.ejemplo.com/login
# API_USER=
# API_PASSWORD=
# API_RESPONSABLES=https://api.ejemplo.com/responsables
# API_PARTICIPANTES=https://api.ejemplo.com/participantes
# API_INSCRIPCION=https://api.ejemplo.com/inscripciones
# Body: { identificacion, grupo (Codigo_Facturacion), anio, mes (MM), valor }
# Auth: Bearer accessToken de API_LOGIN
# API protegida de lectura (ej. get-inscripciones-protegido.php)
API_READ_TOKEN=Qv1sqAbbZS954tIT0POP3Gf73CkvWRhOzmVOO3TyWwKLwQMYgy14Z3OCg2lMdT6SR1hWeyt8Td4wmOwJ
